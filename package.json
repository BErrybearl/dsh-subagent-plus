{
  "name": "dsh-cli-hub",
  "version": "2.0.3",
  "description": "把本机外部 CLI（Codex、Pi、Qoder、OpenCode、CodeBuddy 等）注册成 dsh 子代理，带运行面板、内置子代理观测与后端管理；dsh-subagent 的社区增强分支。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.cjs",
    "lib/*.ps1",
    "src/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-cli-hub",
    "dsh-cli-subagent",
    "deepseek-harness",
    "subagent",
    "qoder",
    "qodercli",
    "qodercn",
    "codex",
    "claude",
    "subscription"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BErrybearl/dsh-cli-subagent.git"
  },
  "homepage": "https://github.com/BErrybearl/dsh-cli-subagent",
  "bugs": {
    "url": "https://github.com/BErrybearl/dsh-cli-subagent/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tool-subagent": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.14.0",
    "react": "^18.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}